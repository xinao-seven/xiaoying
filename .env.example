# 仅用于本地演示，禁止用于生产
MYSQL_DATABASE=xiaoying
MYSQL_USER=xiaoying
MYSQL_PASSWORD=xiaoying
MYSQL_ROOT_PASSWORD=root

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/xiaoying?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=xiaoying
SPRING_DATASOURCE_PASSWORD=xiaoying

APP_DATA_DIR=/data
APP_PIPELINE_CONCURRENCY=1
APP_SIMULATION_DEV_API_ENABLED=true

# 上传上限：单文件与整个 multipart 请求（后者需容纳边界开销）
APP_UPLOAD_MAX_BYTES=10485760
APP_UPLOAD_MAX_REQUEST_SIZE=11MB

BACKEND_URL=http://backend:8080